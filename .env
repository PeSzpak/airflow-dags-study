# Airflow Docker Compose Environment Variables

# Imagem Docker do Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.0

# User ID para os containers do Airflow
# No macOS, você pode usar o padrão 50000
AIRFLOW_UID=50000

# Diretório base do projeto (. significa o diretório atual)
AIRFLOW_PROJ_DIR=.

# Credenciais do administrador da interface web
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Requisitos adicionais do pip (deixe vazio ou adicione pacotes necessários)
# Exemplo: _PIP_ADDITIONAL_REQUIREMENTS=pandas==2.0.0 requests==2.31.0
_PIP_ADDITIONAL_REQUIREMENTS=

# Credenciais do banco de dados PostgreSQL (definidas no docker-compose.yaml)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
